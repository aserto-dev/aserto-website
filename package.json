{
  "name": "next-typescript",
  "version": "0.1.0",
  "description": "A boilerplate for using NextJS with Typescript",
  "repository": "https://github.com/basementstudio/next-typescript",
  "author": "Basement",
  "private": true,
  "scripts": {
    "dev": "next",
    "build": "next build && next export",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "lint": "eslint . --ext ts --ext tsx --ext js --fix",
    "export": "next export",
    "gql-codegen": "graphql-codegen --config gql-codegen.yml -r dotenv/config",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@babel/core": "^7.16.0",
    "@newhighsco/next-plugin-svgr": "^3.0.32",
    "@radix-ui/react-aspect-ratio": "^0.0.13",
    "@radix-ui/react-dropdown-menu": "^0.0.19",
    "@radix-ui/react-id": "^0.0.6",
    "@sanity/block-content-to-react": "^3.0.0",
    "@tailwindcss/forms": "^0.3.3",
    "@typeform/embed": "^1.8.2",
    "@types/react-google-recaptcha": "^2.1.2",
    "@types/react-mailchimp-subscribe": "^2.1.0",
    "clsx": "^1.1.1",
    "date-fns": "^2.22.1",
    "framer-motion": "^4.1.17",
    "graphql": "^15.5.0",
    "graphql-request": "^3.4.0",
    "gsap": "./src/lib/gsap/gsap-bonus.tgz",
    "keen-slider": "^5.5.0",
    "next": "^12.0.4",
    "next-compose-plugins": "^2.2.1",
    "next-plugin-svgr": "^1.0.0",
    "next-sanity": "^0.2.0",
    "next-transpile-modules": "^9.0.0",
    "react": "^17.0.2",
    "react-device-detect": "^1.17.0",
    "react-dom": "^17.0.2",
    "react-google-recaptcha": "^2.1.0",
    "react-hook-form": "^7.8.1",
    "react-icons": "^4.2.0",
    "react-mailchimp-subscribe": "^2.1.3",
    "webpack": "^5.64.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^1.21.5",
    "@graphql-codegen/introspection": "^1.18.2",
    "@graphql-codegen/typescript": "^1.22.1",
    "@graphql-codegen/typescript-graphql-request": "^3.2.1",
    "@graphql-codegen/typescript-operations": "^1.18.0",
    "@types/node": "^15.12.1",
    "@types/react": "^17.0.8",
    "@types/react-dom": "^17.0.6",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "autoprefixer": "^10.2.6",
    "dotenv": "^10.0.0",
    "eslint": "^7.28.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.24.0",
    "graphql-tag": "^2.12.6",
    "eslint-plugin-react-hooks": "^4.3.0",
    "husky": "6.0.0",
    "lint-staged": "11.0.0",
    "next-sitemap": "^1.6.168",
    "postcss": "^8.3.0",
    "prettier": "^2.3.1",
    "react-polymorphic-types": "^1.0.3",
    "sass": "^1.34.1",
    "tailwindcss": "^2.1.4",
    "typescript": "^4.3.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "tabWidth": 2,
    "printWidth": 80,
    "trailingComma": "none"
  },
  "eslintConfig": {
    "env": {
      "es6": true,
      "browser": true,
      "node": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "prettier",
      "plugin:prettier/recommended",
      "plugin:react-hooks/recommended"
    ],
    "globals": {
      "React": "readonly",
      "JSX": "readonly"
    },
    "ignorePatterns": [
      "/.next",
      "/out",
      "/src/lib/sanity/generated.ts"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "react",
      "@typescript-eslint"
    ],
    "rules": {
      "curly": [
        "error",
        "multi-line"
      ],
      "no-console": [
        1,
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "prettier/prettier": [
        "warn"
      ],
      "react/display-name": 0,
      "react/jsx-no-target-blank": [
        2,
        {
          "allowReferrer": true
        }
      ],
      "react/prop-types": 0,
      "react/react-in-jsx-scope": 0,
      "eqeqeq": 2,
      "@typescript-eslint/explicit-function-return-type": 0,
      "@typescript-eslint/explicit-member-accessibility": 0,
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/indent": 0,
      "@typescript-eslint/member-delimiter-style": 0,
      "@typescript-eslint/naming-convention": [
        1,
        {
          "selector": "property",
          "format": [
            "strictCamelCase"
          ],
          "filter": {
            "regex": "[- ]",
            "match": false
          }
        },
        {
          "selector": "interface",
          "format": [
            "PascalCase"
          ]
        }
      ],
      "@typescript-eslint/no-explicit-any": 0,
      "@typescript-eslint/no-use-before-define": 0,
      "@typescript-eslint/ban-ts-comment": 0,
      "@typescript-eslint/no-unused-vars": [
        2,
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-var-requires": 0
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "yarn run type-check"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "yarn lint --fix"
    ]
  }
}
